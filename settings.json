{
  "effortLevel": "low",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "printf '\\a' > /dev/tty",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "printf '\\a' > /dev/tty",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "printf '\\a' > /dev/tty",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(rtk *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(/bin/grep *)",
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(code *)"
    ]
  },
  "prefersReducedMotion": true,
  "shell": {
    "disable_aliases": true
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "$HOME/.claude/statusline-command.sh",
    "refreshInterval": 30,
    "type": "command"
  },
  "syntaxHighlightingDisabled": true
}
