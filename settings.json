{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "permissions": {
    "allow": [
      "Bash(rtk *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(/bin/grep *)",
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(code *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -w /dev/tty ] && printf '\\a' > /dev/tty || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -w /dev/tty ] && printf '\\a' > /dev/tty || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -w /dev/tty ] && printf '\\a' > /dev/tty || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh",
    "refreshInterval": 1
  },
  "spinnerTipsEnabled": false,
  "syntaxHighlightingDisabled": true,
  "effortLevel": "low",
  "awaySummaryEnabled": false,
  "prefersReducedMotion": true,
  "shell": {
    "disable_aliases": true
  }
}
